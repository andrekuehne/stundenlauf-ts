{
  "name": "stundenlauf-ts",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.34.6",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run typecheck && vite build",
    "preview": "vite preview",
    "ci:local": "pnpm install --frozen-lockfile && pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test:coverage && pnpm run build && pnpm run lint && pnpm run inspect:excel-fixtures",
    "prepare": "simple-git-hooks",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ tests/ scripts/ e2e/ \"*.config.ts\"",
    "lint:fix": "eslint src/ tests/ scripts/ e2e/ \"*.config.ts\" --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"scripts/**/*.ts\" \"e2e/**/*.ts\" \"*.config.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"scripts/**/*.ts\" \"e2e/**/*.ts\" \"*.config.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "inspect:excel-fixtures": "tsx scripts/dump-local-excel-fixtures.ts",
    "playwright:install": "playwright install chromium",
    "screenshots:readme": "playwright test e2e/readme-main-screen.spec.ts"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "idb": "^8.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "jszip": "^3.10.1",
    "pdfjs-dist": "^5.6.205",
    "react": "^19",
    "react-dom": "^19",
    "react-router-dom": "^7.14.1",
    "workbox-window": "^7.4.0",
    "xlsx": "^0.18.5",
    "zustand": "^5"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9",
    "eslint-config-prettier": "^10",
    "globals": "^16",
    "jiti": "^2.6.1",
    "jsdom": "^26",
    "prettier": "^3",
    "simple-git-hooks": "^2.13.1",
    "typescript": "~5.8",
    "typescript-eslint": "^8",
    "vite": "^6",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^3",
    "tsx": "4.23.15"
  },
  "simple-git-hooks": {
    "pre-push": "pnpm run ci:local"
  },
  "engines": {
    "node": ">=24.21.0 <25"
  }
}
