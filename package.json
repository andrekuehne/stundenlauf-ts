{
  "name": "stundenlauf-ts",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.34.6",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run typecheck && vite build",
    "preview": "vite preview",
    "ci:local": "pnpm install --frozen-lockfile && pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test:coverage && pnpm run build && pnpm run lint && pnpm run inspect:excel-fixtures && pnpm run test:smoke",
    "prepare": "simple-git-hooks",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage && tsx scripts/check-coverage-scope.ts",
    "test:smoke": "playwright test --config playwright.smoke.config.ts",
    "lint": "eslint src/ tests/ scripts/ e2e/ \"*.config.ts\" .pnpmfile.cjs",
    "lint:fix": "eslint src/ tests/ scripts/ e2e/ \"*.config.ts\" --fix .pnpmfile.cjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"scripts/**/*.ts\" \"e2e/**/*.ts\" \"*.config.ts\" .pnpmfile.cjs",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"scripts/**/*.ts\" \"e2e/**/*.ts\" \"*.config.ts\" .pnpmfile.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "inspect:excel-fixtures": "tsx scripts/dump-local-excel-fixtures.ts",
    "playwright:install": "playwright install chromium",
    "screenshots:readme": "playwright test e2e/readme-main-screen.spec.ts"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "idb": "^8.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "jszip": "^3.10.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "workbox-window": "^7.4.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "simple-git-hooks": "^2.14.0",
    "tsx": "4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "workbox-build": "^7.4.1"
  },
  "simple-git-hooks": {
    "pre-push": "pnpm run ci:local"
  },
  "engines": {
    "node": ">=24.21.0 <25"
  }
}
